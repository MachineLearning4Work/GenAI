APP_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=business-plan-bucket
COMPOSE_PROJECT_NAME=crewai
MINIO_ENABLED=true
MINIO_SECURE=false
MINIO_CONNECT_TIMEOUT=3
MINIO_READ_TIMEOUT=10
MINIO_REGION=us-east-1
JENKINS_PORT=8081
# Docker Desktop uses socket group 0; on Linux use the socket's numeric GID.
DOCKER_GID=0

# ---------------------------------------------------------------------------
# Secrets. Copy this file to `.env` and fill in real values there.
# `.env` is git-ignored - never commit a real key, and never paste one into
# config.py, docker-compose.yml, or the Jenkinsfile.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
CREWAI_LLM=openai/gpt-4o-mini
API_ACCESS_TOKEN=
