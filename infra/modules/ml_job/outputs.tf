output "metrics_path" {
  # Outputs are printed by Terraform and are useful to humans or other modules.
  description = "Path to the JSON metrics produced by the ML job."
  value       = "${var.project_root}/runs/${var.run_name}/metrics.json"
}

output "predictions_path" {
  # This points to the CSV generated by the Python job.
  description = "Path to the CSV predictions produced by the ML job."
  value       = "${var.project_root}/runs/${var.run_name}/predictions.csv"
}

output "run_name" {
  # Echo the selected run name so it is visible after apply.
  description = "The logical name of this ML run."
  value       = var.run_name
}
